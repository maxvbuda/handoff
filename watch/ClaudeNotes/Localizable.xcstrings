    "Couldn't reach the relay. Check your connection.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia z przekaźnikiem. Sprawdź internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el relé. Revisa tu conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relais injoignable. Vérifiez votre connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay nicht erreichbar. Prüfe deine Verbindung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il relay. Controlla la connessione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o relay. Verifique a conexão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーに接続できません。接続を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接中继，请检查网络。"
          }
        }
      }
    },
