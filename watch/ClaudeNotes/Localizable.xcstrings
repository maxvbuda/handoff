    "Your Mac runs these while a handoff start or handoff host is open. Swipe to delete.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac uruchamia je, gdy działa handoff start lub handoff host. Przesuń, aby usunąć."
          }
        },
        "es": {
          "stringUnit": {
