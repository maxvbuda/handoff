    "Clears the Handed off list on this watch. Notes still waiting to send are kept.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyści listę „Przekazano” na tym zegarku. Notatki czekające na wysłanie zostaną zachowane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la lista Entregado de este reloj. Las notas pendientes de envío se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface la liste Transmis de cette montre. Les notes en attente d'envoi sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert die Liste „Übergeben“ auf dieser Uhr. Noch nicht gesendete Notizen bleiben erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota l'elenco Consegnato su questo orologio. Le note in attesa di invio restano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa a lista Entregue neste relógio. Notas aguardando envio são mantidas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このWatchの「送信済み」リストを消去します。送信待ちのメモは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除此手表上的“已交付”列表。等待发送的笔记会保留。"
          }
        }
      }
    },
